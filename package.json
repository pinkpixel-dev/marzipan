{
  "name": "@pinkpixel/marzipan",
  "version": "1.3.1",
  "description": "Pure TypeScript markdown editor library with overlay preview",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Pink Pixel",
  "email": "admin@pinkpixel.dev",
  "homepage": "https://marzipan.pinkpixel.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkpixel-dev/marzipan.git"
  },
  "issues": "https://github.com/pinkpixel-dev/marzipan/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/*.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "serve": "python3 -m http.server 8080",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "markdown",
    "editor",
    "typescript",
    "library",
    "lightweight",
    "textarea",
    "overlay",
    "preview",
    "wysiwyg"
  ],
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "eslint": "^9.37.0",
    "glob": "^11.0.3",
    "globals": "16.4.0",
    "happy-dom": "^21.0.4",
    "mermaid": "^12.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "lodash-es": ">=4.17.23"
  }
}
